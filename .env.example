# =======================================================
# Bia · Bradesco — configuração local (copie para .env)
# =======================================================

# Motor real do agente (Claude).
# Para rodar 100% OFFLINE: deixe vazio OU use MOCK_LLM=true.
# O servidor cai no motor mock — conversa scriptada, sem internet e sem custo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Banco. Vazio = SQLite local em data/bia.db (roda offline, zero setup).
# Em produção (Vercel), aponte para um banco Turso — o dialeto é o mesmo
# do SQLite, então nenhuma query muda:
#   TURSO_DATABASE_URL=libsql://<seu-banco>-<org>.turso.io
#   TURSO_AUTH_TOKEN=<token gerado pelo `turso db tokens create`>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Porta do servidor Express local
PORT=3001

# true = força o motor mock mesmo com a API key presente
MOCK_LLM=false
